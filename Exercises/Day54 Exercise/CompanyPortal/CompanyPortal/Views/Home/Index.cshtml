@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">

    <!-- Hero Section -->
    <div class="p-5 mb-5 text-white rounded-3 text-center" style="background-color:white;">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-dark">Welcome to NextGen Technologies</h1>
            <p class="col-md-8 fs-5 mx-auto text-dark">
                We deliver innovative IT solutions, professional consulting, and high-quality training programs
                to help businesses grow in the digital era.
            </p>
            <a asp-controller="Home" asp-action="About" class="btn btn-primary btn-lg" id="liveToastBtn">
                Learn More About Us
            </a>
        </div>
    </div>
    
    <!-- Section Title -->
    <h2 class="text-center mb-4">Our Services</h2>

    <div class="row g-4">

        <!-- Consulting Card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://media.istockphoto.com/id/1947499362/photo/happy-group-of-business-people-discussing-strategy-during-team-meeting-at-the-office-desk.jpg?s=612x612&w=0&k=20&c=UXPrlQx09d8EP4_kTdAa-vC2LxD_ppY1tiG7eTPGVbE=" class="card-img-top" alt="Consulting Services" style="height:200px; object-fit:cover;">
                <div class="card-body text-center">

                    <h5 class="card-title">Consulting</h5>

                    <p class="card-text">
                        Expert IT consulting services to help businesses improve efficiency,
                        adopt modern technologies, and grow faster.
                    </p>

                    <a asp-controller="Services" asp-action="Consulting"
                       class="btn btn-primary">
                        Explore Consulting
                    </a>

                </div>
            </div>
        </div>

        <!-- Training Card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTqXuxN4-6LeemYWclgOnf4d61mtY71aeuT4Q&s"
                class="card-img-top" alt="Training Programs" style="height:200px; object-fit:cover;">
                <div class="card-body text-center">
                    
                    <h5 class="card-title">Training</h5>

                    <p class="card-text">
                        Professional training programs designed for students,
                        developers, and industry professionals.
                    </p>

                    <a asp-controller="Services" asp-action="Training"
                       class="btn btn-success">
                        View Training
                    </a>

                </div>
            </div>
        </div>

        <!-- Products Card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTw2v4JXzqmsuoDPBV3Ygc_LUXSYml7ft0k7Q&s"
                class="card-img-top" alt="Software Products" style="height:200px; object-fit:cover;">
                <div class="card-body text-center">

                    <h5 class="card-title">Products</h5>

                    <p class="card-text">
                        Discover our modern software products and productivity
                        tools designed for digital transformation.
                    </p>

                    <a asp-controller="Products" asp-action="Software"
                       class="btn btn-warning text-white">
                        View Products
                    </a>

                </div>
            </div>
        </div>

    </div>
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">

        <div id="liveToast" class="toast" role="alert">

            <div class="toast-header">
                <strong class="me-auto">NextGen Technologies</strong>
                <small>Just now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>

            <div class="toast-body">
                Welcome to NextGen Technologies! 🚀
            </div>

        </div>

    </div>
</div>
<script>
    var toastTrigger = document.getElementById('liveToastBtn');
    var toastLiveExample = document.getElementById('liveToast');

    if (toastTrigger) {

        toastTrigger.addEventListener('click', function (event) {

            event.preventDefault(); // stop immediate redirect

            var toast = new bootstrap.Toast(toastLiveExample);
            toast.show();

            // redirect after 2 seconds
            setTimeout(function () {
                window.location.href = "/Home/About";
            }, 2000);

        });

    }

</script>