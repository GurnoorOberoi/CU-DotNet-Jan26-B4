
@{
    ViewData["Title"] = "Index";
}

<div class="container mt-5">

    <h2 class="text-center mb-4">Our Services</h2>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">

                    <h4>Consulting</h4>

                    <p>
                        Professional IT consulting services for businesses to
                        improve productivity and efficiency.
                    </p>

                    <a asp-action="Consulting" class="btn btn-primary">
                        View Consulting
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">

                    <h4>Training</h4>

                    <p>
                        Industry-level training programs for students and professionals.
                    </p>

                    <a asp-action="Training" class="btn btn-success">
                        View Training
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>

