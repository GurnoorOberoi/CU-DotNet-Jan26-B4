
@{
    ViewData["Title"] = "Consulting";
}

<div class="container mt-5">

    <h2 class="text-center mb-4">Consulting Services</h2>

    <div class="accordion" id="consultingAccordion">

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#c1">
                    IT Strategy Consulting
                </button>
            </h2>

            <div id="c1" class="accordion-collapse collapse show">
                <div class="accordion-body">
                    We help companies develop effective IT strategies
                    to improve performance and innovation.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#c2">
                    Cloud Consulting
                </button>
            </h2>

            <div id="c2" class="accordion-collapse collapse">
                <div class="accordion-body">
                    Guidance for migrating and managing cloud infrastructure.
                </div>
            </div>
        </div>

    </div>

</div>

