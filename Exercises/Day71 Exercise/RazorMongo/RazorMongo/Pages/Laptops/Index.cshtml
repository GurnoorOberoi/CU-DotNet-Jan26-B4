@page
@model RazorMongo.Pages.Laptops.IndexModel

<h2>Laptop Inventory</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<a href="/Laptops/Create" class="btn btn-success mb-3">Add Laptop</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Model</th>
            <th>Serial</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Laptops)
        {
            <tr>
                <td>@item.ModelName</td>
                <td>@item.SerialNumber</td>
                <td>@item.Price</td>
            </tr>
        }
    </tbody>
</table>