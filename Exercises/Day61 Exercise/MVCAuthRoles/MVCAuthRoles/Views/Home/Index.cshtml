@{
    ViewData["Title"] = "Home";
}

<style>
    .hero {
        width: 100%;
        min-height: 90vh;
        background: linear-gradient(135deg, #0f172a, #1e3a8a);
        color: white;
        display: flex;
        align-items: center;
    }

    .hero-inner {
        width: 100%;
        padding: 60px 80px;
    }

    .hero h1 {
        font-size: 48px;
        font-weight: bold;
    }

    .hero p {
        margin-top: 15px;
        font-size: 18px;
        opacity: 0.9;
    }

    .btn-main {
        margin-top: 25px;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        color: white;
    }

        .btn-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

    .hero-img {
        width: 100%;
        max-width: 550px;
        border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.4);
    }

    @@media (max-width: 768px) {
        .hero-inner {
            padding: 30px;
        }

        .hero h1 {
            font-size: 32px;
        }
    }
</style>

<!-- FULL WIDTH HERO -->
<div class="hero">

    <div class="hero-inner">
        <div class="row align-items-center">

            <!-- LEFT TEXT -->
            <div class="col-md-6">
                <h1>Smart Car Management System</h1>
                <p>
                    Manage your vehicles, track performance, and analyze data
                    with a powerful and modern dashboard.
                </p>

                <a href="/Identity/Account/Login" class="btn-main">
                    Get Started
                </a>
            </div>

            <!-- RIGHT IMAGE -->
            <div class="col-md-6 text-center">
                <img src="/images/car.png" class="hero-img" />
            </div>

        </div>
    </div>

</div>