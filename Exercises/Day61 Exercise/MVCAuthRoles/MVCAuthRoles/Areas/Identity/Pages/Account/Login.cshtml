@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(135deg, #0f172a, #1e3a8a);
    }

    .login-container {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-box {
        width: 900px;
        display: flex;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,0.4);
    }

    /* LEFT SIDE (IMAGE + OVERLAY) */
    .left-side {
        width: 50%;
        position: relative;
        background: url('/images/car.png') no-repeat center;
        background-size: cover;
    }

    .left-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15,23,42,0.6), rgba(30,58,138,0.8));
    }

    .left-content {
        position: absolute;
        bottom: 40px;
        left: 30px;
        color: white;
        z-index: 2;
    }

        .left-content h2 {
            font-size: 28px;
            font-weight: bold;
        }

        .left-content p {
            font-size: 14px;
            opacity: 0.9;
        }

    /* RIGHT SIDE */
    .right-side {
        width: 50%;
        background: #ffffff;
        padding: 50px;
    }

    .form-title {
        font-size: 26px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .form-sub {
        color: #6b7280;
        margin-bottom: 25px;
    }

    .form-control {
        border-radius: 8px;
        height: 45px;
        margin-bottom: 15px;
    }

    .btn-login {
        width: 100%;
        height: 45px;
        border-radius: 8px;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        border: none;
        color: white;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

    @@media (max-width: 768px) {
        .login-box {
            flex-direction: column;
        }

        .left-side {
            height: 200px;
        }
    }
</style>

<div class="login-container">

    <div class="login-box">

        <!-- 🔥 LEFT SIDE -->
        <div class="left-side">
            <div class="left-overlay"></div>

            <div class="left-content">
                <h2>Drive Your Data</h2>
                <p>Smart car management with real-time insights</p>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="right-side">

            <div class="form-title">Welcome Back</div>
            <div class="form-sub">Login to continue</div>

            <form method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="Input.Email" class="form-control" placeholder="Email address" />
                <input asp-for="Input.Password" class="form-control" placeholder="Password" />

                <div class="d-flex justify-content-between mb-3">
                    <div class="form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label>Remember</label>
                    </div>

                    <a asp-page="./ForgotPassword">Forgot?</a>
                </div>

                <button type="submit" class="btn-login">
                    Sign In
                </button>

                <p class="text-center mt-3">
                    Don’t have an account?
                    <a asp-page="./Register">Register</a>
                </p>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}