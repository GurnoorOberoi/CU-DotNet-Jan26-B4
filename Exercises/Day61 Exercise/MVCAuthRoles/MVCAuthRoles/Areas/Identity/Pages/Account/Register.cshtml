@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(135deg, #0f172a, #1e3a8a);
    }

    .register-container {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .register-box {
        width: 950px;
        display: flex;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,0.4);
    }

    /* LEFT SIDE */
    .left-side {
        width: 50%;
        background: url('/images/car.png') no-repeat center;
        background-size: cover;
        position: relative;
    }

    .left-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15,23,42,0.6), rgba(30,58,138,0.8));
    }

    .left-content {
        position: absolute;
        bottom: 40px;
        left: 30px;
        color: white;
        z-index: 2;
    }

        .left-content h2 {
            font-size: 28px;
            font-weight: bold;
        }

        .left-content p {
            font-size: 14px;
            opacity: 0.9;
        }

    /* RIGHT SIDE */
    .right-side {
        width: 50%;
        background: white;
        padding: 40px;
    }

    .form-title {
        font-size: 26px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .form-sub {
        color: #6b7280;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 8px;
        height: 45px;
        margin-bottom: 12px;
    }

    .btn-register {
        width: 100%;
        height: 45px;
        border-radius: 8px;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        border: none;
        color: white;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

    @@media (max-width: 768px) {
        .register-box {
            flex-direction: column;
        }

        .left-side {
            height: 200px;
        }
    }
</style>

<div class="register-container">

    <div class="register-box">

        <!-- LEFT SIDE -->
        <div class="left-side">
            <div class="left-overlay"></div>

            <div class="left-content">
                <h2>Create Your Account</h2>
                <p>Join and start managing your vehicles smarter</p>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="right-side">

            <div class="form-title">Register</div>
            <div class="form-sub">Create a new account</div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="Input.Email" class="form-control" placeholder="Email address" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>

                <input asp-for="Input.Password" class="form-control" placeholder="Password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

                <button id="registerSubmit" type="submit" class="btn-register mt-2">
                    Register
                </button>

                <p class="text-center mt-3">
                    Already have an account?
                    <a asp-page="./Login">Login</a>
                </p>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}