

@{
    ViewData["Title"] = "Home";
}

<style>
    .main-box {
        width: 80%;
        margin: auto;
        margin-top: 40px;
        font-family: Arial;
    }

    .section {
        border: 1px solid #ccc;
        padding: 20px;
        margin-bottom: 20px;
    }

        .section h2 {
            color: black;
        }

    .btn {
        padding: 8px 14px;
        background-color: black;
        color: white;
        text-decoration: none;
        margin-right: 10px;
    }
</style>

<div class="main-box">
    <h1 class="display-4">Welcome to Training Portal</h1>
    <div class="section">
        
        <h2>Training Portal</h2>
        <p>
            The Training Portal is a web application developed using
            ASP.NET Core MVC to provide information about training
            programs offered by the college.
        </p>
    </div>

    <div class="section">
        <h2>Objectives</h2>
        <ul>
            <li>Provide information about available courses</li>
            <li>Help students explore training opportunities</li>
            <li>Demonstrate MVC architecture concepts</li>
        </ul>
    </div>

    <div class="section">
        <h2>Why Choose Our Training?</h2>
        <p>
            Our training programs focus on practical knowledge,
            skill development, and career preparation.
        </p>
    </div>

</div>



