@using NorthwindCatalog.DTOs
@model List<ProductDto>

<style>
    .product-card {
        border-radius: 18px;
        transition: all 0.3s ease;
        border: none;
        background: linear-gradient(145deg, #ffffff, #f0f0f0);
    }

        .product-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0px 15px 30px rgba(0,0,0,0.2);
        }

    .price {
        font-size: 20px;
        font-weight: bold;
        color: #28a745;
    }

    .inventory {
        font-size: 18px;
        font-weight: bold;
        color: #0d6efd;
    }

    .stock-badge {
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 20px;
    }
</style>

<div class="container mt-5">
    <h2 class="text-center fw-bold mb-4">🛍️ Products</h2>

    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card product-card shadow-sm h-100 text-center p-3">

                    <h5 class="fw-bold mb-3">@p.ProductName</h5>

                    <div class="price">₹ @p.UnitPrice</div>

                    <div class="mt-3">
                        <span class="badge bg-warning text-dark stock-badge">
                            Stock: @p.UnitsInStock
                        </span>
                    </div>

                    <hr />

                    <div class="inventory">
                        ₹ @p.InventoryValue
                    </div>
                    <small class="text-muted">Inventory Value</small>

                </div>
            </div>
        }
    </div>
</div>
<div class="mb-3">
    <a href="/Categories/Index" class="btn btn-outline-secondary">
        ← Back to Categories
    </a>
</div>